[Desktop Entry]
Name=BrightEyes
Comment=Image and simple video viewer
Exec=brighteyes %U
Icon=org.jeremy.BrightEyes
StartupWMClass=brighteyes
Type=Application
Categories=Graphics;GNOME;ImageViewer;
MimeType=application/x-cbz;application/x-cbr;application/zip;application/x-rar;image/*;video/*;
Terminal=false
